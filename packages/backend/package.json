{
  "name": "@roteirizador/backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "sync": "tsx --conditions react-server src/scripts/syncReports.ts",
    "sync:all": "tsx --conditions react-server src/scripts/syncReports.ts freights && tsx --conditions react-server src/scripts/syncReports.ts manifests && tsx --conditions react-server src/scripts/syncReports.ts pickups",
    "sync-url": "tsx --conditions react-server src/scripts/syncUrl.ts",
    "sync:start": "tsx --conditions react-server src/scripts/startSync.ts",
    "sync:finish": "tsx --conditions react-server src/scripts/finishSync.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
